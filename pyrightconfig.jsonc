// ===========================================================================
//                         BAOBAB ENTERPRISE PLATFORM
// ===========================================================================
//
// File
// ----
//     pyrightconfig.json
//
// Tool
// ----
//     Pyright (static type checker)
//
// Referenced by
// -------------
//     pyproject.toml → [project.optional-dependencies] → quality
//
// Invocation
// ----------
//     uv run pyright
//     uv run pyright services/backend        (single-project check)
//
// Format note
// -----------
//     Pyright's config-file parser is comment-tolerant JSON (JSONC), so
//     this file is annotated the same way the rest of the repository's
//     tool-config files are — comments here are safe and will not break
//     `uv run pyright`.
//
//
// PURPOSE
// -------
//
// This is Pyright's dedicated configuration, closing the gap flagged in the
// root pyproject.toml's "TOOL CONFIGURATION REGISTRY": pyright was declared
// as a dependency in the `quality` group but had no policy file, so it was
// silently running against tool defaults instead of repository policy.
//
//
// SCOPE STATUS AT TIME OF AUTHORING
// ----------------------------------
//
// Every path below is a PLANNED workspace member (see the "UV WORKSPACE
// READINESS ROADMAP" in pyproject.toml) that currently contains only a
// `.gitkeep` placeholder — there is no real Python source to type-check
// yet. Running `uv run pyright` today will report "No source files found
// to be analyzed" for each path, which is expected and not an error.
//
// This file is written now, rather than deferred, so that:
//   • the moment real code lands in any of these directories it is
//     immediately covered by policy instead of defaults;
//   • the six `executionEnvironments` below double as living documentation
//     of the intended per-service Python typing boundaries.
//
// ACTION ITEM: `plugins/connectors`, `plugins/customer_extensions`,
// `plugins/marketplace`, and `plugins/reports` are NOT included below,
// because they do not yet have even a placeholder pyproject.toml (see
// pyproject.toml's future-scaling notes). Add an executionEnvironment entry
// for any of them here at the same time it is added to the workspace
// readiness table, so the two files never drift apart.
//
{
  // -------------------------------------------------------------------------
  // Global settings
  // -------------------------------------------------------------------------

  // Matches the exact interpreter pinned in .python-version / the
  // requires-python range in pyproject.toml. Keeping these three in sync
  // is a manual step today — see "MAINTENANCE NOTE" at the bottom of this
  // file for the checklist to follow whenever the platform's Python
  // version policy changes.
  "pythonVersion": "3.14",

  // "basic" rather than "strict": every workspace member is currently an
  // empty placeholder. Starting at "strict" from day one is the right
  // long-term goal for a platform explicitly positioned as long-lived
  // enterprise software, but forcing strict mode before any real code
  // exists would just produce noise-free passes that give false
  // confidence. Escalate to "strict" per-service (via that service's own
  // executionEnvironment override below) as each one clears the UV
  // workspace readiness checklist in pyproject.toml — do not wait for
  // every service to be ready before escalating any of them.
  "typeCheckingMode": "basic",

  // Pyright should resolve third-party stubs/types even for libraries that
  // ship without inline type information (common for older Django/Celery
  // ecosystem packages), rather than silently under-reporting.
  "useLibraryCodeForTypes": true,

  // uv-managed environments live in a project-local .venv by convention
  // (this is uv's default). Pointing Pyright at it means editors and CLI
  // runs resolve the exact same interpreter and installed packages that
  // `uv sync` produces, rather than whatever Python happens to be on PATH.
  "venvPath": ".",
  "venv": ".venv",

  // Directories that should never be type-checked, repository-wide. This
  // mirrors bandit.yaml's exclude_dirs for the same underlying reasons:
  // generated code, dependency/build artefacts, and non-source assets are
  // not meaningful targets for static analysis.
  "exclude": [
    "**/.venv",
    "**/venv",
    "**/node_modules",
    "**/__pycache__",
    "**/*.egg-info",
    "**/build",
    "**/dist",
    "**/site",
    "**/migrations",
    ".devcontainer",
    "docs"
  ],

  // Explicit top-level include list rather than "check everything under
  // the repo root": the root itself has no Python source of its own (see
  // pyproject.toml — `dependencies = []`, `package = false`), and apps/
  // (Next.js, Flutter) and infrastructure/deployment/design/resources are
  // non-Python by design. Listing members explicitly also means a stray
  // Python file dropped outside a recognised project boundary gets
  // flagged as "not covered" rather than silently swept into a scan.
  "include": [
    "services/backend",
    "services/ai",
    "services/worker",
    "shared/python",
    "packages/python",
    "sdk/python"
  ],

  // -------------------------------------------------------------------------
  // Per-service execution environments
  // -------------------------------------------------------------------------
  //
  // Each planned workspace member gets its own executionEnvironment so
  // that import resolution roots stay scoped to that service and don't
  // leak across service boundaries (e.g. services/ai should not be able
  // to silently resolve an import intended for services/backend). This
  // also gives each service an independent place to opt into "strict"
  // once it clears the workspace readiness checklist, without affecting
  // its siblings.
  "executionEnvironments": [
    {
      // Django backend: extraPaths intentionally empty for now — revisit
      // once the real Django project layout (settings module location,
      // apps under platform/ and products/) exists, since Django's import
      // resolution often needs the project package root added explicitly.
      "root": "services/backend",
      "pythonVersion": "3.14"
    },
    {
      // AI service (FastAPI / LangChain / LlamaIndex per pyproject.toml's
      // documented intent for this service).
      "root": "services/ai",
      "pythonVersion": "3.14"
    },
    {
      // Background worker (Celery per pyproject.toml's documented intent).
      "root": "services/worker",
      "pythonVersion": "3.14"
    },
    {
      // Shared platform library consumed by the services above. Held to
      // the same "basic" baseline for now; strongly consider promoting
      // this one to "strict" first once it has real code, since type
      // errors in a shared library have the widest blast radius across
      // the platform.
      "root": "shared/python",
      "pythonVersion": "3.14"
    },
    {
      "root": "packages/python",
      "pythonVersion": "3.14"
    },
    {
      // Public SDK: held to "basic" for now like everything else, but
      // flagged here as the strongest future candidate for "strict" plus
      // `reportMissingTypeStubs` enabled, since this is the one project
      // in the workspace whose type signatures are a public API contract
      // for external/customer consumers rather than internal-only code.
      "root": "sdk/python",
      "pythonVersion": "3.14"
    }
  ]

  // ---------------------------------------------------------------------
  // MAINTENANCE NOTE — keeping Python version policy in sync
  // ---------------------------------------------------------------------
  // This platform's Python version is currently declared in THREE places
  // by necessity (each tool reads a different mechanism):
  //   1. .python-version         → exact interpreter pin (3.14.6)
  //   2. pyproject.toml          → requires-python range (>=3.14.6,<3.15)
  //   3. pyrightconfig.json      → pythonVersion (3.14, minor-only — this
  //                                 field does not accept a patch component)
  // Whenever the platform's Python version policy changes, update all
  // three in the same commit/PR.
}
